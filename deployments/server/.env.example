# Generated secrets are written by ./deploy.sh init; keep .env between upgrades.
COMPOSE_PROJECT_NAME=plane
APP_DOMAIN=plane.example.com
WEB_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com
SITE_ADDRESS=plane.example.com
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
TRUSTED_PROXIES=private_ranges
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
DEBUG=0
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
GUNICORN_WORKERS=2
NUM_PROXIES=1
POSTGRES_USER=plane
POSTGRES_PASSWORD=
POSTGRES_DB=plane
PGDATABASE=plane
PGHOST=plane-db
POSTGRES_PORT=5432
DATABASE_URL=
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/0
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane
AMQP_URL=
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
API_BASE_URL=http://api:8000
API_KEY_RATE_LIMIT=60/minute
CORS_ALLOWED_HEADERS=
